{
  "name": "arranged-agents",
  "displayName": "Arranged Agents",
  "description": "Calls the locally installed Copilot CLI and presents its answers as structured Markdown.",
  "version": "0.1.0",
  "publisher": "xadupre",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/xadupre/arranged-agents.git"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.13.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "arrangedAgents.open",
        "title": "Arranged Agents: Open"
      },
      {
        "command": "arrangedAgents.ask",
        "title": "Arranged Agents: Ask Copilot"
      }
    ],
    "configuration": {
      "title": "Arranged Agents",
      "properties": {
        "arrangedAgents.cliPath": {
          "type": "string",
          "default": "copilot",
          "scope": "machine",
          "description": "Path to your installed Copilot CLI executable. It is executed directly, not through a shell."
        },
        "arrangedAgents.model": {
          "type": "string",
          "default": "",
          "description": "Copilot model ID. Empty uses the CLI default."
        },
        "arrangedAgents.approvedUrlOrigins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Remembered URL roots approved for reading (scheme, hostname and optional port, for example https://example.com). Applies across repositories. Remove an entry to require approval again. HTTPS GitHub file reads are automatically approved."
        },
        "arrangedAgents.requestTimeoutMinutes": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 35791,
          "description": "Maximum total duration of a Copilot operation in minutes, including tools and permission waits. Changes apply to subsequent operations, including in existing sessions."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "coverage": "npm run compile && c8 --all --src dist/src --include=dist/src/** --reporter=lcov --reporter=text --reports-dir=build/coverage/typescript node --test dist/test/*.test.js",
    "smoke": "npm run compile && node dist/scripts/smoke.js",
    "check": "npm run format:check && npm run lint && npm test",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --skip-license"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.27",
    "@vscode/markdown-it-katex": "^1.1.2",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/markdown-it": "^14.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^4.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@github/copilot-sdk": {
      "zod": "^4.6.7"
    },
    "@vscode/vsce": {
      "@azure/identity": "4.13.0"
    },
    "@vscode/markdown-it-katex": {
      "katex": "^0.19.1"
    }
  }
}
